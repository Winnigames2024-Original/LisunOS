# ============================================================
#  Служба шаблонного приложения LisunOS
#  Полный список возможностей .service — в README.md рядом
# ============================================================
import winforms

winforms.Application templateApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

# --- внешний вид окна задаётся здесь, без правки designer ---
MainForm.size = 760, 520
MainForm.minsize = 560, 400
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center = true
MainForm.resizable = true

templateApp.program.addForm(MainForm)

# --- метаданные приложения ---
templateApp.title = "Шаблон приложения"
templateApp.description = "Основа для своего приложения LisunOS"

# основная команда запуска формы
templateApp.namespace = "template"

# дополнительные псевдонимы той же формы
templateApp.command = "tpl"
templateApp.command = "demo"

# true — форма откроется сразу при загрузке системы
templateApp.autostart = false

# --- фоновая служба: работает без окна, по таймеру ---
# run выполняется тем же исполнителем, что и терминал,
# поэтому доступна любая команда системы.
daemon template-watch
    description = "Пример фоновой службы: пишет время в журнал"
    run         = "echo Шаблон жив"
    interval    = 5m
    autostart   = false
    permission  = read_files
end

log Шаблон готов. Запуск: template, tpl, demo
log Фоновая служба: daemon start template-watch
