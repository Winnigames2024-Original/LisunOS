# Каталог приложений LisunOS — служба приложения
import winforms

winforms.Application storeApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

MainForm.size       = 860, 580
MainForm.minsize    = 720, 500
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center     = true
MainForm.resizable  = true

storeApp.program.addForm(MainForm)

storeApp.title       = "Каталог приложений"
storeApp.description = "Пакеты LisunOS и установка в один щелчок"
storeApp.namespace   = "store"
storeApp.command     = "apps-store"
storeApp.autostart   = false

log Каталог готов. Запуск: store
