# Калькулятор LisunOS — служба приложения
import winforms

winforms.Application calcApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

MainForm.size       = 420, 560
MainForm.minsize    = 380, 520
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center     = true
MainForm.resizable  = true

calcApp.program.addForm(MainForm)

calcApp.title       = "Калькулятор"
calcApp.description = "Вычисления с историей и памятью"
calcApp.namespace   = "calc"
calcApp.command     = "calculator"
calcApp.autostart   = false

log Калькулятор готов. Запуск: calc
