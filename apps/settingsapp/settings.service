# Параметры системы LisunOS — служба приложения
import winforms

winforms.Application settingsApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

MainForm.size       = 820, 620
MainForm.minsize    = 720, 560
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center     = true
MainForm.resizable  = true

settingsApp.program.addForm(MainForm)

settingsApp.title       = "Параметры системы"
settingsApp.description = "Язык, раскладка, разрешения, сервер и PHP"
settingsApp.namespace   = "settings"
settingsApp.command     = "options"
settingsApp.autostart   = false

log Параметры готовы. Запуск: settings
