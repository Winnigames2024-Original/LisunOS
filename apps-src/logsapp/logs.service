# LogsApp — журнал ядра
import winforms

winforms.Application logsApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

MainForm.size       = 880, 600
MainForm.minsize    = 720, 480
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center     = true
MainForm.resizable  = true

logsApp.program.addForm(MainForm)

logsApp.title       = "Журнал"
logsApp.description = "Журнал ядра с поиском и выгрузкой"
logsApp.namespace   = "logs"
logsApp.command     = "logs"
logsApp.autostart   = false

log LogsApp готов. Запуск: logs
