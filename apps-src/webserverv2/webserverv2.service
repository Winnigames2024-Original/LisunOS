# Служба панели сервера LisunOS v2
import winforms

winforms.Application serverApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

# внешний вид окна задаётся прямо в сервисе
MainForm.size = 1000, 752
MainForm.minsize = 880, 650
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center = true
MainForm.resizable = true

serverApp.program.addForm(MainForm)

serverApp.title = "Сервер LisunOS v2"
serverApp.description = "Запуск HTTP-сервера на этом устройстве"

# основная команда запуска формы
serverApp.namespace = "webserverv2"

# короткие псевдонимы той же формы
serverApp.command = "server"
serverApp.command = "www"
serverApp.command = "httpd"

serverApp.autostart = false

log Панель сервера v2 готова. Открыть форму: webserverv2 (также server, www, httpd)
