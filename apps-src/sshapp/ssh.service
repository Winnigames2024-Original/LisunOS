# SshApp — сетевой доступ к оболочке LisunOS
import winforms

winforms.Application sshApp = new winforms.Application()

winforms.Form MainForm = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

MainForm.size       = 900, 620
MainForm.minsize    = 780, 540
MainForm.background = #0D1117
MainForm.foreground = #CED6E0
MainForm.center     = true
MainForm.resizable  = true

sshApp.program.addForm(MainForm)

sshApp.title       = "Доступ по сети"
sshApp.description = "Подключение к LisunOS с телефона или другого ПК"
sshApp.namespace   = "sshapp"
sshApp.command     = "ssh-app"
sshApp.autostart   = false

log SshApp готов. Запуск: ssh-app
