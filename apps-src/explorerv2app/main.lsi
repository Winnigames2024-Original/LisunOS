# Сценарий установки Проводника LisunOS
require_core 1.1.0

log Начало развёртывания ExplorerApp

# права запрашиваются из meta.json автоматически,
# но можно попросить дополнительное прямо в сценарии:
request_permission read_files

mkdir root/documents
set_data explorer_view=details

register_service explorer.service
register_command files -> explorerApp

protect
request_restart
