# Графический Проводник LisunOS — сервис приложения
import winforms

# --- дескриптор приложения ---
winforms.Application explorerApp = new winforms.Application()

# --- главная форма: логика + designer ---
winforms.Form Form1 = new winforms.Form("%appfiles%\Form1.cs", "%appfiles%\Form1.designer.cs")

# --- внешний вид формы задаётся прямо здесь ---
Form1.size = 1020, 640
Form1.minsize = 720, 440
Form1.background = #16181D
Form1.foreground = #CED6E0
Form1.center = true
Form1.resizable = true

# --- регистрация формы в приложении ---
explorerApp.program.addForm(Form1)

# --- метаданные приложения ---
explorerApp.title = "Проводник LisunOS"
explorerApp.description = "Файловый менеджер виртуальной файловой системы"
explorerApp.namespace = "explorer"
explorerApp.command = "fm"
explorerApp.autostart = false

# --- оболочка по умолчанию ---
explorerApp.program.setDefaultForm(Form1)

log Проводник LisunOS готов. Команды запуска: explorer, fm
