# Сценарий установки Каталога приложений LisunOS
require_core 1.1.0

log Установка StoreApp

set_data store_url=https://raw.githubusercontent.com/Winnigames2024-Original/LisunOS/main/apps/catalog.json

request_permission network
request_permission write_files

register_service store.service
register_command apps-store -> storeApp

protect
request_restart
